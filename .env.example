NODE_ENV=production
HOST=127.0.0.1
PORT=5311
DATABASE_URL=postgres://alz_app:change-me@127.0.0.1:5432/alzheimers_hub
DATABASE_SSL=require
OIDC_ISSUER=https://identity.example.org/
OIDC_AUDIENCE=alzheimers-care-hub
OIDC_LOGIN_URL=https://identity.example.org/authorize
AUTH_PUBLIC_KEY_BASE64=base64-encoded-RS256-public-key
DATA_ENCRYPTION_KEY_BASE64=base64-encoded-32-byte-key
CALLBACK_SIGNING_SECRET=replace-with-at-least-32-random-characters
FHIR_ENABLED=false
FHIR_BASE_URL=https://fhir.example.org
FHIR_BEARER_TOKEN=
OBJECT_STORE_ENABLED=false
OBJECT_STORE_BASE_URL=https://objects.example.org
OBJECT_STORE_BEARER_TOKEN=
OBJECT_STORE_BUCKET=alzheimers-clinical-documents
ALLOW_SCHEMA_MIGRATION=0
